PROJECT_NAME           = "Resolved Grain Cooling"
PROJECT_BRIEF          = "Resolved-polycrystal thermoelasticity and basal damage"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/doxygen"
CREATE_SUBDIRS         = NO
FULL_PATH_NAMES        = NO

INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/main.cpp" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/include" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/src"
FILE_PATTERNS          = *.cpp *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/*

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

GENERATE_HTML          = YES
HTML_TIMESTAMP         = NO
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
