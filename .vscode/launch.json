{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch Precompiled Binary",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/main", 
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
      // "preLaunchTask" has been removed so VS Code skips compiling
    }
  ]
}