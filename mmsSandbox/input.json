    "MeshRefinementParameters": {
        "NumberOfRefinementCycles": {
            "value": "3"
        },
        "RefinementStrategy": {
            "value": "uniform"
        },
        "FractionToRefine": {
            "value": "0.3"
        },
        "FractionToCoarsen": {
            "value": "0.03"
        }
    },
    "ModelParameters": {
        "InitialTemperature": {
            "value": "2000",
            "default_value": "2000",
            "documentation": "Initial temperature of the body",
            "pattern": "0",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]"
        },
        "ManufacturedDisplacementAmplitude": {
            "value": "2.382e-4",
            "default_value": "2.382e-4",
            "documentation": "Amplitude U0 of the manufactured displacement. Chosen so the elastic and thermal load contributions are comparable; with U0=1 the CTE term is ~4000x smaller and effectively untested.",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]"
        },
        "LengthOfTheBody": {
            "value": "1",
            "default_value": "1",
            "documentation": "Length of the body in meters",
            "pattern": "2",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]"
        },
        "TemperatureIncrement": {
            "value": "20",
            "default_value": "100",
            "documentation": "Temperature increment for each step",
            "pattern": "1",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]"
        },
        "FinalTemperature": {
            "value": "1800",
            "default_value": "500",
            "documentation": "Temperature at the end of cooling process",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]"
        },
        "AppliedAxialStrainRate": {
            "value": "0",
            "default_value": "0.02",
            "documentation": "dEpsilonZZ per unit pseudo-time (see main.cpp header)",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]"
        }
    },
    "OutputParameters": {
        "OutputDirectory": {
            "value": "output",
            "default_value": "output",
            "documentation": "Directory to store output files",
            "pattern": "25",
            "pattern_description": "[DirectoryName]"
        },
        "OutputFileNamePrefix": {
            "value": "solution",
            "default_value": "solution",
            "documentation": "Prefix for output file names",
            "pattern": "26",
            "pattern_description": "[Anything]"
        },
        "OutputFrequency": {
            "value": "10",
            "default_value": "10",
            "documentation": "Frequency of output (in terms of number of steps)",
            "pattern": "27",
            "pattern_description": "[Integer range 1...2147483647 (inclusive)]"
        }
    },
    "SolverParameters": {
        "DamageIncrementRelativeTolerance": {
            "value": "1e-5",
            "default_value": "1e-5",
            "documentation": "Relative tolerance for damage increment in in displacement-damage iteration",
            "pattern": "22",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]"
        },
        "DisplacementIncrementRelativeTolerance": {
            "value": "1e-5",
            "default_value": "1e-5",
            "documentation": "Relative tolerance for displacement increment in in displacement-damage iteration",
            "pattern": "21",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]"
        },
        "ForceEqulibriumRelativeTolerance": {
            "value": "1e-4",
            "default_value": "1e-4",
            "documentation": "Relative tolerance for force equilibrium residiual in displacement-damage iteration",
            "pattern": "20",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]"
        },
        "KineticAlgebraicSolverTolerance": {
            "value": "1e-4",
            "default_value": "1e-4",
            "documentation": "Relative tolerance of iterative algebraic solver for kinetic equation",
            "pattern": "24",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]"
        },
        "MaxNumberOfIterations": {
            "value": "100",
            "default_value": "100",
            "documentation": "Maximum number of iterations for displacement-damage iteration",
            "pattern": "23",
            "pattern_description": "[Integer range 1...2147483647 (inclusive)]"
        },
        "LinearSolverTolerance": {
            "value": "1e-8",
            "default_value": "1e-6",
            "documentation": "Relative tolerance (vs |rhs|) for the CG linear solve. Set tight here (not the 1e-6 production default) so the algebraic stress-damage consistency check in process_solution measures the COUPLING rather than the linear solver -- at 1e-6 it bottomed out at ~1.4e-3*StressThreshold; at 1e-12 it reaches ~2e-11*StressThreshold, i.e. round-off.",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]"
        },
        "MaxLinearSolverIterations": {
            "value": "200000",
            "default_value": "1000",
            "documentation": "Iteration cap for the CG linear solve.",
            "pattern_description": "[Integer range 1...2147483647 (inclusive)]"
        }
    },
    "ParallelizationParameters": {
        "UseWorkStream": {
            "value": "true",
            "default_value": "true",
            "documentation": "Assemble and predict damage via WorkStream::run (multi-threaded). false selects the reference single-threaded loops, kept for A/B correctness and timing comparison.",
            "pattern_description": "[Bool]"
        },
        "NumberOfThreads": {
            "value": "0",
            "default_value": "0",
            "documentation": "Thread cap for WorkStream. 0 = all available cores.",
            "pattern_description": "[Integer range 0...2147483647 (inclusive)]"
        }
    }
}